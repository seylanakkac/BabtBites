<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Push bildirimleri (APNs).
	     Bu anahtar OLMADAN iOS uygulamayi APNs'e hic kaydetmez; APNs token
	     olusmaz ve FirebaseMessaging.getToken() "apns-token-not-set" ile
	     patlar. Kullanici tarafinda bu, "Bildirimleri Ac" dedigi halde hicbir
	     sey olmamasi seklinde gorunuyordu.

	     Deger "production": Codemagic yalnizca App Store dagitimi icin
	     (release derleme, app-store export) uretiyor. Xcode ile yerel debug
	     derlemesi yapilacaksa "development" gerekir.

	     App ID'de (tr.com.babybites) Push Notifications yetkisi ACIK olmali;
	     dogrulandi (04.08.2026). Kapali olsaydi imzalama basarisiz olurdu. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
